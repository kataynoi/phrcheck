# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง — .env ไม่ถูก commit ขึ้น git
#   cp .env.example .env
#
# ไฟล์นี้มี 2 ชุดค่า: LOCAL (เครื่องตัวเอง) กับ PRODUCTION
# เลือกเปิดใช้ทีละชุด

# =============================================================================
# MySQL
# =============================================================================
DB_NAME=phrcheck_db
DB_USER=phrcheck_user
DB_PASS=เปลี่ยนเป็นรหัสผ่านของคุณ
DB_ROOT_PASS=เปลี่ยนเป็นรหัสผ่าน root ของคุณ

# =============================================================================
# ชุดที่ 1 — LOCAL (http บนเครื่องตัวเอง)
# =============================================================================
CI_ENVIRONMENT=development
APP_BASE_URL=http://localhost:8087/
APP_INDEX_PAGE=
LINE_CALLBACK_URL=http://localhost:8087/login/callback
COOKIE_SECURE=false
TRUSTED_PROXY_IPS=
NGINX_BIND=0.0.0.0:8087
DB_BIND=0.0.0.0:3311

# =============================================================================
# ชุดที่ 2 — PRODUCTION (https ผ่าน nginx reverse proxy ที่ path /phrcheck/)
# ใช้เมื่อไหร่ให้ comment ชุดที่ 1 ทั้งบล็อก แล้วเปิดบล็อกนี้แทน
# =============================================================================
#CI_ENVIRONMENT=production
#APP_BASE_URL=https://mkho-mis.moph.go.th/phrcheck/
#APP_INDEX_PAGE=
#LINE_CALLBACK_URL=https://mkho-mis.moph.go.th/phrcheck/login/callback
# cookie ส่งเฉพาะช่องทาง https
#COOKIE_SECURE=true
# IP ของ reverse proxy — ถ้า proxy อยู่เครื่องเดียวกันใช้ 127.0.0.1
#TRUSTED_PROXY_IPS=127.0.0.1
# ปิดไม่ให้พอร์ตของ container โผล่ออกอินเทอร์เน็ต ให้เข้าได้เฉพาะจากเครื่องตัวเอง
#NGINX_BIND=127.0.0.1:8087
#DB_BIND=127.0.0.1:3311

# =============================================================================
# LINE Login (LINE Developers > channel ประเภท LINE Login)
# Channel ID เป็นตัวเลข 10 หลัก / Channel Secret เป็น hash 32 ตัว
# LINE_CALLBACK_URL ต้องตรงกับ Callback URL ในหน้า channel เป๊ะ ๆ (ดูด้านบน)
# =============================================================================
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# LINE userId ของ Admin คนแรก — ล็อกอินด้วยบัญชีนี้จะได้สิทธิ์ admin
# และผ่านการอนุมัติอัตโนมัติ (bootstrap ไม่ต้องรอใครมาอนุมัติ)
ADMIN_LINE_USER_ID=
