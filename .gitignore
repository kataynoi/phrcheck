# ---------------------------------------------------------------
# ความลับ — .env มีรหัสผ่านฐานข้อมูลและ LINE Channel Secret
# ใช้ .env.example เป็นแม่แบบแทน
# ---------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------
# ข้อมูลส่วนบุคคล — ไฟล์ export จากระบบ PHR มีเลขบัตรประชาชนจริง
# ห้าม commit เด็ดขาด
# ---------------------------------------------------------------
data_sample/*.xlsx
data_sample/*.xls
data_sample/*.csv

# ---------------------------------------------------------------
# Dependencies — ติดตั้งตอน build image ไม่ต้องเก็บใน repo
# ---------------------------------------------------------------
src/vendor/
src/composer.lock

# ---------------------------------------------------------------
# ไฟล์ที่ CI4 เขียนตอนรัน
# ---------------------------------------------------------------
src/writable/cache/*
src/writable/logs/*
src/writable/session/*
src/writable/uploads/*
src/writable/debugbar/*
!src/writable/**/index.html

# ---------------------------------------------------------------
# ระบบปฏิบัติการ / เครื่องมือ
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
*.log
.idea/
.vscode/
